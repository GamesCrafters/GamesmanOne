{
    "C_Cpp.clang_format_path": "/usr/bin/clang-format",
    "C_Cpp.doxygen.sectionTags": [
        "attention",
        "bug",
        "deprecated",
        "exception",
        "invariant",
        "note",
        "param",
        "pre",
        "post",
        "remark",
        "remarks",
        "result",
        "returns",
        "retval",
        "sa",
        "see",
        "since",
        "tparam",
        "warning",
    ],
    "cmake.automaticReconfigure": false,
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.preRunCoverageTarget": "coverage-clean",
    "cmake.postRunCoverageTarget": "coverage-generate",
    "cmake.coverageInfoFiles": [
        "${command:cmake.buildDirectory}/lcov.info",
    ],
    "cmake.ctest.allowParallelJobs": true,
    "cmake.useCMakePresets": "always",
    "testing.coverageToolbarEnabled": true,
}